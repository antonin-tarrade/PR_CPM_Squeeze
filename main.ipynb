   "source": [
    "from Compression import *\n",
    "\n",
    "\n",
    "obj_path = \"./models/bunny.obj\"\n",
    "\n",
    "with open(obj_path, 'r') as f:\n",
    "    objref = Object3D(f,\"Reference\")\n",
    "    objref.Show()\n",
    "\n",
    "objA = AObject3D(objref, \"Object A\")\n",
    "objA.compress(0.1,20)\n",
    "objA.show_last_lod();"
   ]
  },
